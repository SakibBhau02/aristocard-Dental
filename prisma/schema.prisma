generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/* ------------------------------------------------------------------ */
/*  Aristocrat Dental Care — Data Models                               */
/* ------------------------------------------------------------------ */

model Appointment {
  id          String   @id @default(cuid())
  refCode     String   @unique
  name        String
  phone       String
  email       String?
  date        String
  time        String
  doctorSlug  String?
  serviceSlug String?
  notes       String?
  status      String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED | COMPLETED
  source      String   @default("WEBSITE")
  /* Daily lead pipeline (admin-only, never public):
     followUpDate - the next day the front desk should call this lead;
     adminNotes   - internal working notes (call outcomes, preferences). */
  followUpDate String? // YYYY-MM-DD
  adminNotes   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Review {
  id          String   @id @default(cuid())
  name        String
  phone       String? // optional, for verification
  rating      Int // 1-5
  serviceSlug String? // optional treatment
  title       String?
  message     String
  approved    Boolean  @default(false) // moderation: only approved shown publicly
  createdAt   DateTime @default(now())
}

/* Registered patient accounts — powers the Patient Portal (#/portal).
   Signup is by Bangladeshi mobile number (unique); password is stored as
   "scrypt:<salt>:<hash>" (never plaintext). Appointments link to accounts
   at query time via the shared `phone` field, so historic bookings made
   BEFORE signup appear automatically in the logged-in dashboard.        */
model Patient {
  id           String   @id @default(cuid())
  phone        String   @unique
  name         String
  email        String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/* ------------------------------------------------------------------ */
/*  CMS models — every editable piece of the public site               */
/*  (SQLite has no array type → JSON strings, parsed in src/lib/content)*/
/* ------------------------------------------------------------------ */

/* Doctors — full CRUD from the admin panel */
model Doctor {
  id               String   @id @default(cuid())
  slug             String   @unique
  legacyId         Int      @default(0)
  sort             Int      @default(0)
  name             String
  credentialsJson  String   @default("[]") // ["BDS","MDS"]
  role             String
  roleBn           String?
  department       String
  departmentBn     String?
  bio              String
  experienceYears  Int      @default(1)
  patientsTreated  Int      @default(0)
  rating           Float    @default(4.8)
  specializationsJson String @default("[]")
  languagesJson    String   @default("[\"Bangla\",\"English\"]")
  consultationDaysJson String @default("[]")
  accent           String   @default("#012c5f")
  photo            String?  // /public/uploads/... or /images/...
  /* Round 17-a — enriched profile dossier:
     educationJson  - [{"degree":"BDS","institution":"University of Dhaka","year":"2016"}]
     membershipsJson- ["Bangladesh Dental Association"]
     awardsJson     - [{"title":"...","year":"..."}]
     quote/quoteBn  - personal philosophy pull-quote shown on the profile
     focusServicesJson - service slugs this doctor focuses on
                        (links the profile to /services/<slug> pages)     */
  educationJson    String?  // [{degree, institution?, year?}]
  membershipsJson  String?  // string[]
  awardsJson       String?  // [{title, year?}]
  quote            String?
  quoteBn          String?
  focusServicesJson String? // service slugs, e.g. ["invisalign-clear-aligners"]
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/* Blog posts — CRUD with bilingual sections */
model BlogPost {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  titleBn           String?
  excerpt           String
  excerptBn         String?
  category          String   @default("General")
  readTime          String   @default("5 min read")
  date              String   // YYYY-MM-DD
  updated           String?
  author            String   @default("Dr. Shazia Khanam")
  authorCredentials String   @default("BDS, MDS")
  featured          Boolean  @default(false)
  tagsJson          String   @default("[]")
  serviceRefsJson   String?  // curated related service slugs
  image             String?
  imageAlt          String?
  quickAnswer       String
  quickAnswerBn     String?
  sectionsJson      String   // EN sections [{heading,body[],list?[]}]
  sectionsBnJson    String?
  status            String   @default("PUBLISHED") // PUBLISHED | DRAFT
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/* FAQs — CRUD, ordered */
model Faq {
  id          String   @id @default(cuid())
  sort        Int      @default(0)
  question    String
  questionBn  String?
  answer      String
  answerBn    String?
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

/* Smile gallery case studies — CRUD with before/after images */
model SmileCase {
  id            String   @id @default(cuid())
  slug          String   @unique
  sort          Int      @default(0)
  treatment     String
  category      String   @default("Cosmetic") // Cosmetic|Orthodontics|Restorative|Preventive
  serviceSlug   String?
  beforeSrc     String
  afterSrc      String
  beforeAlt     String?
  afterAlt      String?
  title         String
  patient       String
  age           Int      @default(30)
  duration      String
  proceduresJson String  @default("[]")
  result        String
  featured      Boolean  @default(false)
  updatedAt     DateTime @updatedAt
}

/* Service content overlay — slug is LOCKED (referential integrity for
   appointments/blog/cases/search); everything else is editable.      */
model ServiceContent {
  slug          String   @id
  name          String?
  nameBn        String?
  shortName     String?
  shortNameBn   String?
  tagline       String?
  taglineBn     String?
  excerpt       String?
  excerptBn     String?
  image         String?
  icon          String?
  duration      String?
  longevity     String?
  anesthesia    String?
  featured      Boolean?
  overviewJson  String?  // string[]
  benefitsJson  String?  // [{title,description}]
  processJson   String?  // [{step,title,description}]
  idealJson     String?  // string[]
  faqsJson      String?  // [{question,answer}]
  updatedAt     DateTime @updatedAt
}

/* Home hero slides — images and YouTube videos, ordered */
model HeroSlide {
  id        String   @id @default(cuid())
  scope     String   @default("home")
  sort      Int      @default(0)
  kind      String   @default("image") // image | youtube
  src       String   // image path OR full YouTube URL
  alt       String?
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

/* Key → JSON blobs for page-level editable content.
   Keys: "home" | "about" | "settings"                                  */
model PageBlock {
  key       String   @id
  dataJson  String   @default("{}")
  updatedAt DateTime @updatedAt
}

/* ------------------------------------------------------------------ */
/*  Admin staff accounts — powers the admin panel login (#/admin)      */
/*  Passwords: scrypt with per-user random salt ("scrypt:salt:hash").  */
/*  Roles:    OWNER (full access incl. settings + staff management)    */
/*            EDITOR (all content + engagement, read-only settings)    */
/*            VIEWER (read-only dashboards)                            */
/*  A separate legacy path (x-admin-code header / ADMIN_PASSCODE env)  */
/*  remains for trusted automation and is treated as OWNER.            */
/* ------------------------------------------------------------------ */
model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  displayName  String
  passwordHash String
  role         String    @default("EDITOR") // OWNER | EDITOR | VIEWER
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/* Immutable audit trail — one row per admin mutation/login event.     */
model AdminActivity {
  id         String   @id @default(cuid())
  actor      String // username, or "automation" for passcode-header calls
  actorLabel String?  // display name at the time of the event
  role       String?  // role at the time of the event
  action     String   // create | update | delete | reorder | login | logout | login-failed | settings | upload
  entity     String   // doctors | blog | faqs | cases | services | pages | hero | settings | users | auth | upload
  label      String?  // human summary (entity slug/name/title or message)
  createdAt  DateTime @default(now())
}

/* ------------------------------------------------------------------ */
/*  First-party server-side analytics — one row per visitor event.     */
/*  Privacy-safe: no raw IPs (salted hash), no PII; `label` holds      */
/*  things like the search query or the CTA name, `session` is an      */
/*  anonymous localStorage id. Powers the admin Analytics panel.       */
/* ------------------------------------------------------------------ */
model TrackingEvent {
  id        String   @id @default(cuid())
  type      String // page_view | search | cta_call | cta_whatsapp | booking_click | language | appointment_booked | message_sent | review_submitted | newsletter_signup
  path      String? // hash-route path, e.g. "/services/dental-implants"
  label     String? // search query / cta name / ref code
  metaJson  String   @default("{}") // small extra context (service, device detail…)
  session   String? // anonymous visitor session id
  device    String? // mobile | tablet | desktop | bot
  referrer  String? // document.referrer (trimmed)
  ipHash    String? // salted sha256 prefix — never the raw IP
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([createdAt])
  @@index([session])
}
