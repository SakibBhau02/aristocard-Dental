# =====================================================================
#  Aristocrat Dental Care — environment template
#  Copy to .env (local) and paste the same values into Vercel
#  Project → Settings → Environment Variables.
# =====================================================================

# --- Neon Postgres ---------------------------------------------------
# Neon dashboard → your project → Connection Details.
# DATABASE_URL = pooled (ends with -pooler, has ?sslmode=require)
# DIRECT_URL   = direct (no -pooler) — used by `prisma migrate deploy`.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/dbname?sslmode=require"

# --- Cloudflare R2 (images) -------------------------------------------
# R2 dashboard → your bucket → Settings.
# R2_PUBLIC_URL = public access URL: either the r2.dev subdomain
#   (bucket Settings → Public Access → Allow Access, e.g.
#   https://pub-xxxxxxxxxxxxxxxx.r2.dev) or a connected custom domain
#   (e.g. https://img.aristocratdentalcarebd.com). REQUIRED in production —
#   Vercel's filesystem is read-only, so uploads ONLY work via R2 there.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="aristocart-uploads"
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxx.r2.dev"

# --- Admin panel ------------------------------------------------------
# Trusted-automation passcode (x-admin-code header). CHANGE from default
# before going live — anyone with this code has OWNER access.
ADMIN_PASSCODE="change-me-to-a-long-random-string"
# Session signing salt — set a long random string in production so admin
# logins survive passcode rotation and can't be forged with the default.
ADMIN_SESSION_SECRET="change-me-to-another-long-random-string"

# --- Patient portal ----------------------------------------------------
# Session signing salt for patient logins (same advice as above).
PATIENT_SESSION_SECRET="change-me-to-a-long-random-string"
